# 复制这个文件为 .env，然后把你的真实 key 填进去
# 命令：Copy-Item .env.example .env
# 注意：.env 已被 .gitignore 排除，永远不要提交它

# DeepSeek（platform.deepseek.com）—— 主力模型，便宜
DEEPSEEK_API_KEY=sk-在这里填你的key

# 可选：以后接别家模型时用
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx

# 可选：默认模型名（代码里读这个变量，方便换模型）
DEFAULT_MODEL=deepseek-chat
